# Django core
SECRET_KEY=replace-this-with-a-long-random-secret
# DEBUG defaults to False when unset, so production stays safe by default.
# For local development set DEBUG=True to get stack traces and static file
# auto-serving without running collectstatic.
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Include every origin that serves the Django app. Local development defaults to
# http://localhost:8000 and http://127.0.0.1:8000 when this value is omitted.
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# PostgreSQL database
# Most hosts provide this automatically after you create a PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Supabase Storage for uploaded media files
# In Supabase: create the project, create the Storage bucket, then copy the S3
# values from Project Settings -> Storage -> S3 (endpoint + region) and create
# an S3 access key pair on that same page. The anon / service_role API keys do
# NOT work here.
#
# The bucket must be marked public in Supabase Storage -> <bucket> -> Settings,
# otherwise uploads succeed but every generated file link returns an error.
# Supabase's S3 API does not implement ACLs, so no `public-read` ACL is sent.
USE_SUPABASE_STORAGE=True
SUPABASE_STORAGE_BUCKET=nexus-media
# Endpoint: project URL + /storage/v1/s3. Never append the bucket name here and
# never use the /storage/v1/object/... URL (that one is the public file URL).
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-key
# Copy the exact region from the S3 settings page (e.g. ap-southeast-1,
# us-east-1, eu-central-1). A mismatched region makes every upload fail with
# "Invalid Region" or "SignatureDoesNotMatch".
SUPABASE_S3_REGION_NAME=us-east-1
# Public base URL for generated file links; the bucket name must match
# SUPABASE_STORAGE_BUCKET exactly.
SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/nexus-media
#
# Verify all of the above before going live:
#   python manage.py check_file_storage

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=NExUS System <your-email@gmail.com>

# Security switches for HTTPS production
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=False
CSRF_USE_SESSIONS=False
CSRF_COOKIE_SAMESITE=Lax

# Session / login protection
SESSION_COOKIE_AGE=600
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
