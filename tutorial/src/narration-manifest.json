{
  "count": 30,
  "scenes": [
    {
      "scene": 1,
      "segments": [
        {
          "file": "narration/s01-01.mp3",
          "at": 10,
          "frames": 50,
          "text": "Welcome to nexus."
        },
        {
          "file": "narration/s01-02.mp3",
          "at": 66,
          "frames": 98,
          "text": "It's the online home for all extension paperwork."
        }
      ]
    },
    {
      "scene": 2,
      "segments": [
        {
          "file": "narration/s02-01.mp3",
          "at": 12,
          "frames": 137,
          "text": "Extension means training and outreach projects run with outside communities."
        },
        {
          "file": "narration/s02-02.mp3",
          "at": 155,
          "frames": 69,
          "text": "One record follows the whole journey."
        }
      ]
    },
    {
      "scene": 3,
      "segments": [
        {
          "file": "narration/s03-01.mp3",
          "at": 12,
          "frames": 156,
          "text": "A proponent owns the proposal; evaluators review it; coordinators endorse it."
        },
        {
          "file": "narration/s03-02.mp3",
          "at": 172,
          "frames": 146,
          "text": "An MOA is the signed partnership agreement. A tracker shows its stage."
        }
      ]
    },
    {
      "scene": 4,
      "segments": [
        {
          "file": "narration/s04-01.mp3",
          "at": 12,
          "frames": 117,
          "text": "Seven roles use nexus, each with a dashboard for its work."
        },
        {
          "file": "narration/s04-02.mp3",
          "at": 150,
          "frames": 69,
          "text": "Next, what each role can do."
        }
      ]
    },
    {
      "scene": 5,
      "segments": [
        {
          "file": "narration/s05-01.mp3",
          "at": 12,
          "frames": 185,
          "text": "Faculty create proposals, answer reviewer comments, run the activity, and file its reports."
        }
      ]
    },
    {
      "scene": 6,
      "segments": [
        {
          "file": "narration/s06-01.mp3",
          "at": 12,
          "frames": 165,
          "text": "Office staff see every proposal, move agreements along, and request quarterly reports."
        }
      ]
    },
    {
      "scene": 7,
      "segments": [
        {
          "file": "narration/s07-01.mp3",
          "at": 12,
          "frames": 194,
          "text": "Evaluators work a review queue, comment on exact sections, and return or approve proposals."
        }
      ]
    },
    {
      "scene": 8,
      "segments": [
        {
          "file": "narration/s08-01.mp3",
          "at": 12,
          "frames": 146,
          "text": "Department coordinators endorse their department's proposals and file its quarterly reports."
        }
      ]
    },
    {
      "scene": 9,
      "segments": [
        {
          "file": "narration/s09-01.mp3",
          "at": 12,
          "frames": 156,
          "text": "Campus coordinators route work across departments and monitor all campus proposals."
        }
      ]
    },
    {
      "scene": 10,
      "segments": [
        {
          "file": "narration/s10-01.mp3",
          "at": 12,
          "frames": 165,
          "text": "The Director assigns evaluators, gives final approval, and watches the office's targets."
        }
      ]
    },
    {
      "scene": 11,
      "segments": [
        {
          "file": "narration/s11-01.mp3",
          "at": 8,
          "frames": 203,
          "text": "Admins run the system — accounts, website, templates, security — but never your proposal."
        }
      ]
    },
    {
      "scene": 12,
      "segments": [
        {
          "file": "narration/s12-01.mp3",
          "at": 10,
          "frames": 108,
          "text": "Your dashboard shows your proposals and where each stands."
        },
        {
          "file": "narration/s12-02.mp3",
          "at": 132,
          "frames": 60,
          "text": "Start one with a single click."
        }
      ]
    },
    {
      "scene": 13,
      "segments": [
        {
          "file": "narration/s13-01.mp3",
          "at": 12,
          "frames": 156,
          "text": "Building a proposal means walking through twenty guided sections, one question at a time."
        },
        {
          "file": "narration/s13-02.mp3",
          "at": 176,
          "frames": 108,
          "text": "Drafts save automatically, so return and submit when complete."
        }
      ]
    },
    {
      "scene": 14,
      "segments": [
        {
          "file": "narration/s14-01.mp3",
          "at": 12,
          "frames": 127,
          "text": "Reviewers comment on the exact section, not vague email threads."
        },
        {
          "file": "narration/s14-02.mp3",
          "at": 150,
          "frames": 108,
          "text": "Every revision stays on the record through seven statuses."
        }
      ]
    },
    {
      "scene": 15,
      "segments": [
        {
          "file": "narration/s15-01.mp3",
          "at": 12,
          "frames": 137,
          "text": "With a partner, the MOA tracker moves through six stages to signing."
        },
        {
          "file": "narration/s15-02.mp3",
          "at": 168,
          "frames": 60,
          "text": "No partner? Skip."
        }
      ]
    },
    {
      "scene": 16,
      "segments": [
        {
          "file": "narration/s16-01.mp3",
          "at": 12,
          "frames": 108,
          "text": "The activity then runs through six stages to final documents."
        },
        {
          "file": "narration/s16-02.mp3",
          "at": 150,
          "frames": 108,
          "text": "Reports and paperwork come from the same record, ready to print."
        }
      ]
    },
    {
      "scene": 17,
      "segments": [
        {
          "file": "narration/s17-01.mp3",
          "at": 12,
          "frames": 127,
          "text": "The public website is edited without code, using reusable blocks."
        },
        {
          "file": "narration/s17-02.mp3",
          "at": 144,
          "frames": 79,
          "text": "Every change is logged with the editor's name."
        }
      ]
    },
    {
      "scene": 18,
      "segments": [
        {
          "file": "narration/s18-01.mp3",
          "at": 12,
          "frames": 175,
          "text": "Every account has verified email, auto-logout, login lockouts, and secure storage."
        }
      ]
    },
    {
      "scene": 19,
      "segments": [
        {
          "file": "narration/s19-01.mp3",
          "at": 8,
          "frames": 117,
          "text": "That's nexus — one record, from idea to finish."
        },
        {
          "file": "narration/s19-02.mp3",
          "at": 129,
          "frames": 69,
          "text": "Log in and start your first proposal."
        }
      ]
    }
  ]
}
